# ==========================================
# DEPLOYMENT ENVIRONMENT VARIABLES
# ==========================================

# 1. FRONTEND (Vercel)
# Create these in the Vercel Dashboard -> Settings -> Environment Variables
# VITE_API_URL should point to your live Render backend URL
VITE_API_URL=https://parking-backend-your-project.onrender.com

# 2. BACKEND (Render)
# Create these in the Render Dashboard -> Environment
# JWT_SECRET is a random string used to sign sessions
# CORS_ORIGINS should include your live Vercel frontend URL
JWT_SECRET=super_secret_production_key_change_me
CORS_ORIGINS=https://your-frontend-project.vercel.app
DATABASE_URL=postgresql://user:pass@host/dbname # (Optional: defaults to SQLite if not provided)

# 3. MOBILE APP (Expo)
# Place an `.env` file in the `mobile-app` directory before building
EXPO_PUBLIC_API_URL=https://parking-backend-your-project.onrender.com
