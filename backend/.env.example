# Demo defaults work out of the box; copy to backend/.env and fill for real deploys.

# SQLite demo (default when unset):
DATABASE_URL=sqlite:///./parking_demo.db
# Postgres example (production):
# DATABASE_URL=postgresql+psycopg2://user:pass@localhost:5432/parking

# REQUIRED in production: long random string (e.g. openssl rand -hex 32). Never commit the real one.
JWT_SECRET=

# Guard session length (8h shift)
JWT_EXPIRE_MINUTES=480

# Slot reservation window before auto-release (minutes)
RESERVED_PENDING_TIMEOUT_MIN=4

# Self-report grace window before auto-promote (minutes)
SELF_REPORT_GRACE_MIN=8

# Comma-separated allowed CORS origins — tighten for production.
# Example: CORS_ORIGINS=https://parking.your-institute.edu
CORS_ORIGINS=http://localhost:5173,http://localhost:8000
